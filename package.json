{
  "name": "@ragbaz/common",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "files": ["src", "scripts", "schema.sql", "README.md", "PROVENANCE.md"],
  "description": "Shared, dependency-light identity and request primitives for RAGBAZ Cloudflare Workers",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./schemas/collection-view": "./schemas/collection-view.schema.json",
    "./crypto": "./src/crypto.js",
    "./handles": "./src/handles.js",
    "./http": "./src/request-bounds.js",
    "./webauthn": "./src/webauthn.js",
    "./turnstile": "./src/turnstile.js",
    "./email-code": "./src/email-code.js",
    "./sessions": "./src/sessions.js",
    "./abuse-gate": "./src/abuse-gate.js",
    "./identity": "./src/identity.js",
    "./content": "./src/content/index.js",
    "./content/markdoc-ragbaz": "./src/content/markdoc-ragbaz.js",
    "./content/visualizations": "./src/content/visualizations.js",
    "./standalone": "./demo/markdoc-ragbaz/standalone.js",
    "./widgets": "./src/widgets/index.ts",
    "./widgets/styles.css": "./src/widgets/widgets.css",
    "./widgets/primitives": "./src/widgets/primitives.ts",
    "./widgets/primitives.css": "./src/widgets/primitives.css",
    "./schema.sql": "./schema.sql",
    "./prefix-migration": "./scripts/prefix-migration.mjs",
    "./build-llms-txt": "./scripts/build-llms-txt.mjs",
    "./content/geometry3d": "./src/content/geometry3d.js",
    "./content/three-adapter": "./src/content/three-adapter.js",
    "./content/geometry-obj": "./src/content/geometry-obj.js",
    "./content/business-plan": "./src/content/business-plan.js",
    "./content/business-chart": "./src/content/business-chart.js",
    "./content/evidence-inspector": "./src/content/evidence-inspector.js",
    "./content/replicad-artifact": "./src/content/replicad-artifact.js",
    "./content/replicad-capture": "./src/content/replicad-capture.js",
    "./content/replicad-locales": "./src/content/replicad-locales.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm test && npm run typecheck && npm run test:widgets",
    "typecheck": "tsc --noEmit",
    "test:widgets": "tsx --test tests/widgets.test.tsx",
    "demo": "npm --prefix demo run dev",
    "demo:build": "tsc --noEmit -p tsconfig.demo.json && npm --prefix demo run build",
    "llms-txt": "node scripts/build-llms-txt.mjs",
    "prefix-migration": "node scripts/prefix-migration.mjs",
    "markdoc-ragbaz": "node scripts/build-markdoc-ragbaz.mjs",
    "markdoc-ragbaz-sci-tufte": "node scripts/build-markdoc-ragbaz-sci-tufte.mjs"
  },
  "dependencies": {
    "@markdoc/markdoc": "0.5.10",
    "@simplewebauthn/server": "13.3.3",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "reactflow": ">=11"
  },
  "peerDependenciesMeta": {
    "reactflow": { "optional": true }
  },
  "devDependencies": {
    "chart.js": "4.6.1",
    "cytoscape": "3.34.4",
    "esbuild": "0.25.11",
    "three": "0.180.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reactflow": "^11.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
