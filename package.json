{
  "name": "@ragbaz/common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared, dependency-light identity and request primitives for RAGBAZ Cloudflare Workers",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./crypto": "./src/crypto.js",
    "./handles": "./src/handles.js",
    "./http": "./src/request-bounds.js",
    "./webauthn": "./src/webauthn.js",
    "./turnstile": "./src/turnstile.js",
    "./email-code": "./src/email-code.js",
    "./sessions": "./src/sessions.js",
    "./abuse-gate": "./src/abuse-gate.js",
    "./identity": "./src/identity.js",
    "./content": "./src/content/index.js",
    "./content/markdoc-ragbaz": "./src/content/markdoc-ragbaz.js",
    "./content/visualizations": "./src/content/visualizations.js",
    "./standalone": "./demo/markdoc-ragbaz/standalone.js",
    "./schema.sql": "./schema.sql",
    "./prefix-migration": "./scripts/prefix-migration.mjs",
    "./build-llms-txt": "./scripts/build-llms-txt.mjs",
    "./content/geometry3d": "./src/content/geometry3d.js",
    "./content/three-adapter": "./src/content/three-adapter.js"
